  "implementation_extracts": [
    {
      "source_sha256": "2df1658bde172c672d7a3d45fe0534fc766bbe952bb53ecf49bc4ebff6b4094e",
      "path": "kr/evidence/2df1658bde172c672d7a3d45fe0534fc766bbe952bb53ecf49bc4ebff6b4094e.txt",
      "range": [
        1,
        68
      ],
      "lines": [
        {
          "line": 1,
          "text": "\"\"\"Confirmed 0x0bbb transport codec. Payload fields are not interpreted.\"\"\""
        },
        {
          "line": 2,
          "text": "import argparse"
        },
        {
          "line": 3,
          "text": "import json"
        },
        {
          "line": 4,
          "text": "from pathlib import Path"
        },
        {
          "line": 5,
          "text": "import struct"
        },
        {
          "line": 6,
          "text": ""
        },
        {
          "line": 7,
          "text": "MAGIC = 0x0BBB"
        },
        {
          "line": 8,
          "text": ""
        },
        {
          "line": 9,
          "text": "def login_response(success=False):"
        },
        {
          "line": 10,
          "text": "    \"\"\"Diagnostic fixture derived from client reads; no account validation.\"\"\""
        },
        {
          "line": 11,
          "text": "    payload = bytearray(0x9F if success else 0x94)"
        },
        {
          "line": 12,
          "text": "    struct.pack_into('<H', payload, 0, 0x13)"
        },
        {
          "line": 13,
          "text": "    payload[0x16] = 0 if success else 1"
        },
        {
          "line": 14,
          "text": "    if success:"
        },
        {
          "line": 15,
          "text": "        # Name occupies 10 UTF-16 code units before the status byte."
        },
        {
          "line": 16,
          "text": "        name = 'LocalTest'.encode('utf-16le')"
        },
        {
          "line": 17,
          "text": "        payload[2:2+len(name)] = name"
        },
        {
          "line": 18,
          "text": "        struct.pack_into('<I', payload, 0x18, 1)  # synthetic account ID"
        },
        {
          "line": 19,
          "text": "        struct.pack_into('<I', payload, 0x1C, 1)  # group count"
        },
        {
          "line": 20,
          "text": "        # Empty optional UTF-16 notice at 0x20; remaining flags zero."
        },
        {
          "line": 21,
          "text": "        # Group: uint16 ID, uint8 channel count."
        },
        {
          "line": 22,
          "text": "        struct.pack_into('<HB', payload, 0x92, 1, 1)"
        },
        {
          "line": 23,
          "text": "        # Channel: uint16 ID, 2 unknown bytes, IPv4 octets, enabled, load."
        },
        {
          "line": 24,
          "text": "        struct.pack_into('<H', payload, 0x95, 1)"
        },
        {
          "line": 25,
          "text": "        payload[0x99:0x9D] = bytes([127, 0, 0, 1])"
        },
        {
          "line": 26,
          "text": "        payload[0x9D] = 1"
        },
        {
          "line": 27,
          "text": "    return bytes(payload)"
        },
        {
          "line": 28,
          "text": ""
        },
        {
          "line": 29,
          "text": "def channel_response(owned_character=False, all_characters=False, *, character_ids=None, expedition_name='LocalTest'):"
        },
        {
          "line": 30,
          "text": "    \"\"\"Experimental command 2 with no trailing character records.\"\"\""
        },
        {
          "line": 31,
          "text": "    payload = bytearray(0x41)"
        },
        {
          "line": 32,
          "text": "    struct.pack_into('<HI', payload, 0, 2, 1)"
        },
        {
          "line": 33,
          "text": "    name = expedition_name.encode('utf-16le')"
        },
        {
          "line": 34,
          "text": "    if len(name)>40 or '\\0' in expedition_name:"
        },
        {
          "line": 35,
          "text": "        raise ValueError('Expedition name must fit 20 UTF-16 code units')"
        },
        {
          "line": 36,
          "text": "    payload[0x0C:0x0C+len(name)] = name"
        },
        {
          "line": 37,
          "text": "    struct.pack_into('<HH', payload, 0x36, 1, 1)"
        },
        {
          "line": 38,
          "text": "    if owned_character:"
        },
        {
          "line": 39,
          "text": "        # 0x35-byte record parsed by 0x4d4150; 0x2e selects character."
        },
        {
          "line": 40,
          "text": "        for character_id in roster_ids(all_characters, character_ids):"
        },
        {
          "line": 41,
          "text": "            record = bytearray(0x35)"
        },
        {
          "line": 42,
          "text": "            name = ('LocalHero'+str(character_id)).encode('utf-16le')"
        },
        {
          "line": 43,
          "text": "            record[:len(name)] = name"
        },
        {
          "line": 44,
          "text": "            struct.pack_into('<I', record, 0x2A, 1)"
        },
        {
          "line": 45,
          "text": "            record[0x2E] = character_id"
        },
        {
          "line": 46,
          "text": "            payload.extend(record)"
        },
        {
          "line": 47,
          "text": "    return bytes(payload)"
        },
        {
          "line": 48,
          "text": ""
        },
        {
          "line": 49,
          "text": "def roster_ids(all_characters=False, character_ids=None):"
        },
        {
          "line": 50,
          "text": "    ids=tuple(character_ids) if character_ids is not None else tuple(range(1,10) if all_characters else (1,))"
        },
        {
          "line": 51,
          "text": "    if not ids or len(set(ids))!=len(ids) or any(type(i)!=int or not 1<=i<=9 for i in ids):"
        },
        {
          "line": 52,
          "text": "        raise ValueError('Character roster must contain unique IDs1..9')"
        },
        {
          "line": 53,
          "text": "    return ids"
        },
        {
          "line": 54,
          "text": ""
        },
        {
          "line": 55,
          "text": ""
        },
        {
          "line": 56,
          "text": "def character_scene_response(owned_character=False, appearance=False, all_characters=False, *, character_ids=None):"
        },
        {
          "line": 57,
          "text": "    payload = bytearray(struct.pack('<H', 0x60))"
        },
        {
          "line": 58,
          "text": "    if owned_character:"
        },
        {
          "line": 59,
          "text": "        # Scene parser 0x4c22c0 consumes 27 bytes per character."
        },
        {
          "line": 60,
          "text": "        for character_id in roster_ids(all_characters, character_ids):"
        },
        {
          "line": 61,
          "text": "            record = bytearray(27)"
        },
        {
          "line": 62,
          "text": "            record[0] = character_id"
        },
        {
          "line": 63,
          "text": "            if appearance and character_id==1:"
        },
        {
          "line": 64,
          "text": "                # Soma appearance ID4; other characters need their own catalog."
        },
        {
          "line": 65,
          "text": "                struct.pack_into('<H', record, 8, 4)"
        },
        {
          "line": 66,
          "text": "            payload.extend(record)"
        },
        {
          "line": 67,
          "text": "    return bytes(payload)"
        },
        {
          "line": 68,
          "text": ""
        }
      ]
    },
    {
      "source_sha256": "2df1658bde172c672d7a3d45fe0534fc766bbe952bb53ecf49bc4ebff6b4094e",
      "path": "kr/evidence/2df1658bde172c672d7a3d45fe0534fc766bbe952bb53ecf49bc4ebff6b4094e.txt",
      "range": [
        107,
        114
      ],
      "lines": [
        {
          "line": 107,
          "text": "def plaza_entry_responses():"
        },
        {
          "line": 108,
          "text": "    \"\"\"Experimental acknowledgement and square scene transition, not world initialization."
        },
        {
          "line": 109,
          "text": ""
        },
        {
          "line": 110,
          "text": "    0x43 -> 4b1a90 removes type-6 pending objects. 0x69 -> 4b9090"
        },
        {
          "line": 111,
          "text": "    reads a signed scene byte and two unsigned location bytes; scene 7"
        },
        {
          "line": 112,
          "text": "    constructs the town module. The association with 0x42 is a test assumption."
        },
        {
          "line": 113,
          "text": "    \"\"\""
        },
        {
          "line": 114,
          "text": "    return (struct.pack('<H', 0x43), struct.pack('<HBBB', 0x69, 7, 1, 1))"
        }
      ]
    },
    {
      "source_sha256": "512368d38b4bc52372e9fc08dbd5d5921827864b1adbfb4e7ba0cb721448d075",
      "path": "kr/evidence/512368d38b4bc52372e9fc08dbd5d5921827864b1adbfb4e7ba0cb721448d075.txt",
      "range": [
        1,
        24
      ],
      "lines": [
        {
          "line": 1,
          "text": "\"\"\"SQLite accounts and per-account saves. No plaintext credentials or tokens.\"\"\""
        },
        {
          "line": 2,
          "text": "import hashlib"
        },
        {
          "line": 3,
          "text": "import hmac"
        },
        {
          "line": 4,
          "text": "import json"
        },
        {
          "line": 5,
          "text": "import re"
        },
        {
          "line": 6,
          "text": "import secrets"
        },
        {
          "line": 7,
          "text": "import sqlite3"
        },
        {
          "line": 8,
          "text": "import time"
        },
        {
          "line": 9,
          "text": "from contextlib import contextmanager"
        },
        {
          "line": 10,
          "text": "from pathlib import Path"
        },
        {
          "line": 11,
          "text": ""
        },
        {
          "line": 12,
          "text": "ITERATIONS=310000"
        },
        {
          "line": 13,
          "text": ""
        },
        {
          "line": 14,
          "text": "def credentials(payload):"
        },
        {
          "line": 15,
          "text": "    if len(payload)!=112 or payload[:2]!=b'\\xe8\\x00':raise ValueError('Invalid login packet')"
        },
        {
          "line": 16,
          "text": "    username=payload[2:53].split(b'\\0',1)[0].decode('ascii')"
        },
        {
          "line": 17,
          "text": "    digest=payload[53:104].split(b'\\0',1)[0].decode('ascii').lower()"
        },
        {
          "line": 18,
          "text": "    if not re.fullmatch(r'[A-Za-z0-9_]{1,10}',username) or not re.fullmatch(r'[0-9a-f]{32}',digest):"
        },
        {
          "line": 19,
          "text": "        raise ValueError('Invalid credentials')"
        },
        {
          "line": 20,
          "text": "    return username,digest"
        },
        {
          "line": 21,
          "text": ""
        },
        {
          "line": 22,
          "text": "def password_digest(password):"
        },
        {
          "line": 23,
          "text": "    if not 1<=len(password)<=50 or not password.isascii():raise ValueError('Password must be 1..50 ASCII characters')"
        },
        {
          "line": 24,
          "text": "    return hashlib.md5(password.encode('ascii')).hexdigest()"
        }
      ]
    },
    {
      "source_sha256": "512368d38b4bc52372e9fc08dbd5d5921827864b1adbfb4e7ba0cb721448d075",
      "path": "kr/evidence/512368d38b4bc52372e9fc08dbd5d5921827864b1adbfb4e7ba0cb721448d075.txt",
      "range": [
        59,
        103
      ],
      "lines": [
        {
          "line": 59,
          "text": "    def create(self,username,password,expedition=None):"
        },
        {
          "line": 60,
          "text": "        if not re.fullmatch(r'[A-Za-z0-9_]{1,10}',username):raise ValueError('Account name must be 1..10 letters/digits/underscore')"
        },
        {
          "line": 61,
          "text": "        digest=password_digest(password);salt=secrets.token_bytes(16)"
        },
        {
          "line": 62,
          "text": "        verifier=hashlib.pbkdf2_hmac('sha256',digest.encode(),salt,ITERATIONS)"
        },
        {
          "line": 63,
          "text": "        state=expedition or {'version':1,'expedition_name':'','characters':[1,3],'stage':'naming'}"
        },
