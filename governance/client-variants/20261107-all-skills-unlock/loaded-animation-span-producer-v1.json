    "fallback": "If entry+4==0,7DB4DE..7DB4F3 call7C5F40(object,&two-int-range initialized0), compute abs(rangeEnd-rangeStart) as signed integer, FILD ->entry+4. Exact all-type fallback range behavior remains partial."
  },
  "rangeProjection": {
    "function": "7C6390",
    "inputABI": "stackarg object/component pointer atEBP+8",
    "walk": "component+98/+9C vector; each element has+3C subtrack count;7C63C7 calls7800E0 with EAX=element and EDI=subtrack index, then virtual+1C gets a range-like pair through output buffer; returned EAX points to pair",
    "accumulate": "minimum first integer maintained inEBX; maximum second integer maintained EBP-C initialized0",
    "return": "7C6411..7C6423 signed integer maximum second integer /160, truncated toward0. Minimum is not subtracted in this primary return.",
    "units": "Exact source-derived unit relationship: entry+4 = float(trunc(maximum returned range-end integer /160)) on primary path. A tick/frame conversion is plausible, but neither seconds nor a complete FPS timebase has been established here.",
    "fallbackEvidence": "7C5F40 observed type-specific branches include returned rangeEnd/160, and another branch compares object+9C float*30. This supports preserving unit distinctions; it does not license a universal seconds formula."
  },
