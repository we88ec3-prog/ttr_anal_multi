{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tartaros:server:local-returning-projectile:v1:not-native-mef",
  "title": "Server-only lab catalogue returning-projectile plan, NOT_NATIVE_MEF",
  "description": "Exported lab catalogue object only. Not a native MEF payload, opcode, original balance or implemented external file loader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "labRange", "labSpeed", "labHitRadius", "labOutboundDamage", "labReturnDamage", "labReturnPullDistance", "labPullStopDistance", "labMaximumLifetimeSeconds"],
  "properties": {
    "schema": {"const": "LOCAL_RETURNING_PROJECTILE_V1_NOT_NATIVE_MEF"},
    "authority": {"const": "SERVER_RECONSTRUCTION_NOT_NATIVE_MEF"},
    "labRange": {"type": "number", "exclusiveMinimum": 0},
    "labSpeed": {"type": "number", "exclusiveMinimum": 0},
    "labHitRadius": {"type": "number", "exclusiveMinimum": 0},
    "labOutboundDamage": {"type": "integer", "minimum": 0},
    "labReturnDamage": {"type": "integer", "minimum": 0},
    "labReturnPullDistance": {"type": "number", "minimum": 0},
    "labPullStopDistance": {"type": "number", "minimum": 0},
    "labMaximumLifetimeSeconds": {"type": "number", "exclusiveMinimum": 0}
  }
}
