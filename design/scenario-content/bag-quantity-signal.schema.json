{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server-owned BagQuantityReached signal; NOT_NATIVE_MEF",
  "type": "object", "additionalProperties": false,
  "required": ["flag", "event", "product", "quantity"],
  "properties": {
    "flag": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$", "maxLength": 64},
    "event": {"const": "BagQuantityReached"},
    "product": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "quantity": {"type": "integer", "minimum": 1, "maximum": 255},
    "region": {"type": "null"}, "interaction": {"type": "null"},
    "delaySeconds": {"type": "null"}, "waveId": {"type": "null"}, "healthPercent": {"type": "null"}
  }
}
