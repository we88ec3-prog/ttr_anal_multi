{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tartaros Server ground loot rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pickupRadius", "rules"],
  "properties": {
    "schema": { "const": "LOCAL_GROUND_LOOT_V1_NOT_NATIVE_MEF" },
    "pickupRadius": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quest", "map", "monster", "visual", "product", "quantity", "metadata"],
        "properties": {
          "quest": { "$ref": "#/$defs/nonzeroU16" },
          "map": { "$ref": "#/$defs/nonzeroU32" },
          "monster": { "$ref": "#/$defs/nonzeroU16" },
          "visual": { "$ref": "#/$defs/nonzeroU16" },
          "product": { "$ref": "#/$defs/nonzeroU32" },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255,
            "description": "Server requires quantity 1 for known independent products."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field10", "field14"],
            "properties": {
              "field10": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "field14": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonzeroU16": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "nonzeroU32": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
  }
}
