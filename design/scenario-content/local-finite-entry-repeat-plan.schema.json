{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server finite entry repeat plan NOT_NATIVE_MEF",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenarioSha256",
    "behaviorSha256",
    "case",
    "sourceNode",
    "visits",
    "flagScope",
    "rewardPolicy",
    "completionPolicy"
  ],
  "properties": {
    "schema": {
      "const": "LOCAL_FINITE_ENTRY_REPEAT_PLAN_V1_NOT_NATIVE_MEF"
    },
    "scenarioSha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "behaviorSha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "case": {
      "const": 693
    },
    "sourceNode": {
      "const": 10
    },
    "visits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "flagScope": {
      "const": "VisitLocalRetainLast"
    },
    "rewardPolicy": {
      "const": "PerVisit"
    },
    "completionPolicy": {
      "const": "OnceAtOriginalResult"
    }
  }
}
