{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tartaros:local-monster-behavior:v1-not-native-mef",
  "title": "Server-owned monster behavior, not native MEF",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nativeMef",
    "profiles"
  ],
  "properties": {
    "schema": {
      "const": "LOCAL_MONSTER_BEHAVIOR_V1_NOT_NATIVE_MEF"
    },
    "nativeMef": {
      "const": false
    },
    "source": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authority",
          "maximumHealth",
          "damage",
          "nativeMovementSpeed",
          "attackMotion",
          "deathMotion",
          "movementSpeed",
          "startDelaySeconds",
          "attackRange",
          "hitRange",
          "followDistance",
          "attackCooldownSeconds",
          "groupAttackGapSeconds",
          "windupSeconds",
          "recoverySeconds",
          "deathRemovalSeconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "const": "SERVER_RECONSTRUCTION_NOT_NATIVE_MEF"
          },
          "maximumHealth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "damage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "nativeMovementSpeed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "attackMotion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "deathMotion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "movementSpeed": {
            "type": "number",
            "maximum": 3600,
            "exclusiveMinimum": 0
          },
          "startDelaySeconds": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "attackRange": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "hitRange": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "followDistance": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "attackCooldownSeconds": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "groupAttackGapSeconds": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "windupSeconds": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "recoverySeconds": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "deathRemovalSeconds": {
            "type": "number",
            "maximum": 3600,
            "minimum": 0
          },
          "canPursue": {
            "type": "boolean",
            "default": true,
            "description": "Pursuit switch; does not prevent an explicit leash return after displacement."
          },
          "aggroRange": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3600
              }
            ],
            "default": null,
            "description": "Optional Server-owned policy, NOT_NATIVE_MEF. See S00 monster leash contract."
          },
          "leashRadius": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3600
              }
            ],
            "default": null,
            "description": "Optional Server-owned policy, NOT_NATIVE_MEF. See S00 monster leash contract."
          },
          "attacks": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "motion",
                    "damage",
                    "attackRange",
                    "hitRange",
                    "windupSeconds",
                    "recoverySeconds",
                    "cooldownSeconds"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "motion": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "damage": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "minimumHealthFraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 0
                    },
                    "maximumHealthFraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "default": 1
                    },
                    "attackRange": {
                      "type": "number",
                      "maximum": 3600,
                      "exclusiveMinimum": 0
                    },
                    "hitRange": {
                      "type": "number",
                      "maximum": 3600,
                      "minimum": 0
                    },
                    "windupSeconds": {
                      "type": "number",
                      "maximum": 3600,
                      "minimum": 0
                    },
                    "recoverySeconds": {
                      "type": "number",
                      "maximum": 3600,
                      "minimum": 0
                    },
                    "cooldownSeconds": {
                      "type": "number",
                      "maximum": 3600,
                      "minimum": 0
                    }
                  }
                }
              }
            ],
            "default": null,
            "description": "Server-owned ordered attack choices, independent cooldowns and inclusive health bands. Missing/empty retains legacy melee."
          }
        }
      }
    }
  },
  "$comment": "Typed loader also checks unique IDs and relations: followDistance < attackRange <= hitRange, windup <= recovery <= attackCooldown, and aggroRange <= leashRadius when both exist. Runtime is Server-owned and no native file compatibility is implied. Attack IDs must be unique per profile; each attack also checks attackRange<=hitRange, windup<=recovery<=cooldown and minimumHealthFraction<=maximumHealthFraction."
}
