{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ttr:handoff:W2:monster-profile-inventory:2.0.0",
  "title": "W2 三怪來源對照（待審資料；非原生 MEF 或可部署 Monster AI）",
  "description": "W2 bounded v2 inventory of ZIP plus pinned original Table/Base members. It preserves unknown AI/time values and separates historical reports from direct resource facts; not a runtime AI schema.",
