  "properties": {
    "format": {
      "const": "W2_MONSTER_PROFILE_INVENTORY_V2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "client_version": {
      "const": "kr"
    },
    "prepared_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "DRAFT_FOR_REVIEW"
    },
    "source_analysis_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_index": {
      "const": "source-index.json"
    },
    "technical_scope": {
      "const": "UPLOADED_PACKAGE_AND_PINNED_TABLE_BASE_ARCHIVES"
    },
    "formal_native_verification": {
      "const": "NOT_T01_FULL_PASS"
    },
    "upstream_t16_activation": {
      "const": "DRAFT_BLOCKED"
    },
    "runtime_ready": {
      "const": false
    },
    "source_status_legend": {
      "type": "object",
      "properties": {
        "已知來源值": {
          "type": "string"
        },
        "候選政策": {
          "type": "string"
        },
        "無來源": {
          "type": "string"
        }
      },
      "required": [
        "已知來源值",
        "候選政策",
        "無來源"
      ],
      "additionalProperties": false
    },
    "matrix_imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/matrixImport"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "server_policy_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
