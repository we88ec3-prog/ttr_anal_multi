      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "carrier": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "member_count": {
