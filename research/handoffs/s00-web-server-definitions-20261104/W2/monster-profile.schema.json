    "raw_resource_verification": {
      "const": "PINNED_ARCHIVE_MEMBERS_REVERIFIED"
    },
    "previous_delivery_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "updated_at": {
      "type": "string"
    },
    "evidence_revision_notes": {
      "type": "string"
    },
